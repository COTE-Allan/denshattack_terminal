---
import { ArrowLeft } from '@lucide/astro';

const { href, label } = Astro.props;
---

<p class="breadcrumb">
  <a href={href} data-backlink>
    <ArrowLeft size={14} aria-hidden="true" />
    <span data-backlink-label>{label}</span>
  </a>
</p>

<script>
  // ?from=... (static site, read client-side) lets the link point back to whichever list sent the visitor here
  const FROM = {
    practice: { href: '/practice', label: 'Back to practice checklist' },
    'route-sheet': { href: '/route-sheet', label: 'Back to route sheet' },
  };

  function applyFromParam() {
    const match = FROM[new URLSearchParams(window.location.search).get('from')];
    if (!match) return;

    document.querySelectorAll('[data-backlink]').forEach((link) => {
      link.setAttribute('href', match.href);
      const label = link.querySelector('[data-backlink-label]');
      if (label) label.textContent = match.label;
    });
  }

  // fires on initial load and after every view transition
  document.addEventListener('astro:page-load', applyFromParam);
</script>
