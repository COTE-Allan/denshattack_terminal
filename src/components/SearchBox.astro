---
import { Search } from '@lucide/astro';

const {
  resultsId,
  size = 'compact', // 'compact' (header) | 'large' (homepage hero)
  placeholder = 'Search everything…',
} = Astro.props;
---

<div class:list={['search-box', { 'search-box--large': size === 'large' }]}>
  {/* GET form: works with no JS, plain navigation to /search?q=... */}
  <form class="search-box__form" action="/search" method="get" autocomplete="off">
    <input
      class="search-box__input"
      type="search"
      name="q"
      placeholder={placeholder}
      aria-label="Search skips, techniques, and stickers"
      role="combobox"
      aria-expanded="false"
      aria-controls={resultsId}
      aria-autocomplete="list"
    />
    <button class="search-box__btn" type="submit" aria-label="Search">
      <Search size={size === 'large' ? 18 : 16} aria-hidden="true" />
    </button>
  </form>

  {/*
    Populated client-side from /search-index.json (see
    src/pages/search-index.json.js) as the visitor types — see the script
    below. Empty/hidden until then, so it degrades to "nothing" rather than
    an error if JS fails to load.
  */}
  <div class="search-box__results" id={resultsId} role="listbox" hidden></div>
</div>

<script>
  import { TYPE_LABELS } from '../lib/format.js';

  const MAX_QUICK_RESULTS = 6;

  let indexPromise = null;
  function loadSearchIndex() {
    // Fetched lazily (on first keystroke, not on page load) and cached for
    // the rest of the session — every page carries at least one of these
    // (the header's), so paying for the fetch once matters.
    indexPromise ??= fetch('/search-index.json').then((r) => r.json());
    return indexPromise;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Classes only, no shared ID: this component can appear more than once on
  // the same page (header + homepage hero), so each instance's results live
  // are found relative to the input that triggered the event, not looked up
  // by a single fixed ID.
  function getResultsEl(input) {
    return input.closest('.search-box')?.querySelector('.search-box__results') ?? null;
  }

  function renderResults(container, input, matches) {
    if (matches.length === 0) {
      container.innerHTML = '<p class="search-box__empty">No matches</p>';
    } else {
      container.innerHTML = matches
        .map(
          (item) => `<a class="search-box__result" href="${item.href}" role="option">
            <span class="search-box__result-type">${TYPE_LABELS[item.type]}</span>
            <span class="search-box__result-title">${escapeHtml(item.title)}</span>
          </a>`
        )
        .join('');
    }
    container.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }

  function closeResults(container, input) {
    if (container) {
      container.hidden = true;
      container.innerHTML = '';
    }
    input?.setAttribute('aria-expanded', 'false');
  }

  document.addEventListener('input', async (e) => {
    const input = e.target.closest?.('.search-box__input');
    if (!input) return;

    const container = getResultsEl(input);
    if (!container) return;

    const q = input.value.trim().toLowerCase();
    if (!q) {
      closeResults(container, input);
      return;
    }

    const items = await loadSearchIndex();
    // The input's value can change while the fetch above was in flight —
    // bail if this response is no longer for the current text.
    if (input.value.trim().toLowerCase() !== q) return;

    const matches = items
      .filter((item) => `${item.title} ${item.summary}`.toLowerCase().includes(q))
      .slice(0, MAX_QUICK_RESULTS);
    renderResults(container, input, matches);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const input = e.target.closest?.('.search-box__input');
    if (!input) return;
    closeResults(getResultsEl(input), input);
  });

  document.addEventListener('click', (e) => {
    document.querySelectorAll('.search-box__results').forEach((container) => {
      if (container.hidden) return;
      const box = container.closest('.search-box');
      if (box && !box.contains(e.target)) {
        closeResults(container, box.querySelector('.search-box__input'));
      }
    });
  });
</script>
