<button class="btn copy-link-btn" type="button" data-copy-link>
  Copy link
</button>

<script>
  // Delegated on `document` (rather than queried once at parse time) so it
  // keeps working after a view transition swaps in a new button element —
  // `document` itself persists across transitions, the button doesn't.
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest?.('[data-copy-link]');
    if (!btn) return;

    try {
      await navigator.clipboard.writeText(window.location.href);
      const original = btn.dataset.originalLabel ?? btn.textContent ?? 'Copy link';
      btn.dataset.originalLabel = original;
      btn.textContent = 'Copied!';
      setTimeout(() => {
        btn.textContent = original;
      }, 1500);
    } catch {
      // Clipboard API can fail (permissions, insecure context) — no-op,
      // the button just won't confirm the copy.
    }
  });
</script>
