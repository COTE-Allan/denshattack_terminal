---
import { ChevronDown, Menu, X } from '@lucide/astro';
import logo from '../assets/logo_denshattack_terminal.png';
import SearchBox from './SearchBox.astro';

const speedrunLinks = [
  { label: 'Skips', href: '/skips' },
  { label: 'Techniques', href: '/techniques' },
  { label: 'Practice', href: '/practice' },
  { label: 'Route sheet', href: '/route-sheet' },
];

const links = [
  { label: 'Stickers', href: '/stickers' },
  { label: 'Stats', href: '/stats' },
];

const path = Astro.url.pathname;
const isCurrent = (href) => path === href || path === `${href}/`;
const isSpeedrunActive = speedrunLinks.some((l) => isCurrent(l.href));
---

<header class="site-header">
  <div class="site-header__inner">
    {/* logo + mobile toggle share a real flex row instead of an absolutely-positioned toggle */}
    <div class="site-header__brand-row">
      <a class="site-header__logo" href="/">
        <img
          class="site-header__logo-img"
          src={logo.src}
          width={logo.width}
          height={logo.height}
          alt="Denshattack Terminal"
        />
      </a>

      {/* hidden above 720px; below it, toggles .site-header--nav-open to show/hide the nav */}
      <button
        type="button"
        class="mobile-nav-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        data-mobile-nav-toggle
      >
        <Menu size={18} class="mobile-nav-toggle__icon mobile-nav-toggle__icon--menu" aria-hidden="true" />
        <X size={18} class="mobile-nav-toggle__icon mobile-nav-toggle__icon--close" aria-hidden="true" />
      </button>
    </div>

    <nav class="site-header__nav" id="mobile-nav-panel" aria-label="Main navigation">
      <ul class="site-header__nav-list">
        <li class="site-header__nav-item">
          {/* <details>/<summary>: keyboard-accessible dropdown, no framework needed */}
          <details class="nav-dropdown">
            <summary
              class="site-header__nav-link nav-dropdown__summary"
              aria-current={isSpeedrunActive ? 'page' : undefined}
            >
              Speedrun
              <ChevronDown size={14} class="nav-dropdown__chevron" aria-hidden="true" />
            </summary>
            <ul class="nav-dropdown__menu">
              {
                speedrunLinks.map((l) => (
                  <li>
                    <a
                      class="nav-dropdown__link"
                      href={l.href}
                      aria-current={isCurrent(l.href) ? 'page' : undefined}
                    >
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>

        {
          links.map((l) => (
            <li class="site-header__nav-item">
              <a
                class="site-header__nav-link"
                href={l.href}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <SearchBox resultsId="header-search-results" />
  </div>
</header>

<script>
  // measures the real header height instead of trusting the hardcoded --header-h fallback, which drifted
  // out of sync on mobile (wrapped content made the header taller than the css assumed, leaving a gap
  // above the hero that relies on --header-h to pull itself up underneath the sticky header)
  let headerResizeObserver;

  function syncHeaderHeight() {
    const header = document.querySelector('.site-header');
    if (!header) return;
    document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    return header;
  }

  document.addEventListener('astro:page-load', () => {
    headerResizeObserver?.disconnect();
    const header = syncHeaderHeight();
    if (header && 'ResizeObserver' in window) {
      headerResizeObserver = new ResizeObserver(syncHeaderHeight);
      headerResizeObserver.observe(header);
    }
  });

  // delegated on `document`, which persists across view transitions, unlike the header's own nodes
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.nav-dropdown[open]').forEach((dropdown) => {
      if (!dropdown.contains(e.target)) dropdown.removeAttribute('open');
    });

    const toggle = e.target.closest?.('[data-mobile-nav-toggle]');
    if (toggle) {
      const header = toggle.closest('.site-header');
      const isOpen = header.classList.toggle('site-header--nav-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      return;
    }

    // closes the panel on an outside click, same as the dropdown above
    document.querySelectorAll('.site-header--nav-open').forEach((header) => {
      if (e.target.closest('.site-header__nav')) return;
      header.classList.remove('site-header--nav-open');
      header.querySelector('[data-mobile-nav-toggle]')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
