---
import { ArrowUp } from '@lucide/astro';
---

<button class="back-to-top" type="button" id="back-to-top" aria-label="Back to top" hidden>
  <ArrowUp size={20} aria-hidden="true" />
</button>

<script>
  // re-queried on every scroll/click, not cached, so it survives a view transition swapping the button (see copylinkbutton.astro)
  window.addEventListener(
    'scroll',
    () => {
      const btn = document.getElementById('back-to-top');
      if (btn) btn.hidden = window.scrollY < 600;
    },
    { passive: true }
  );

  document.addEventListener('click', (e) => {
    const btn = e.target.closest?.('#back-to-top');
    if (btn) window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
