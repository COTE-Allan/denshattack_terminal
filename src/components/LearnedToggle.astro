---
import { Check } from '@lucide/astro';

const { skipId } = Astro.props;
---

{/*
  Plain vanilla JS, not a React island: this is a single boolean flip on
  one localStorage key, not worth shipping React just for this one button
  on an otherwise fully static page. Reads/writes the exact same
  "denshattack:learned-skips" key as useLearned.js, so this stays in sync
  with the catalog's per-card toggle and the /practice checklist.
*/}
<button
  type="button"
  class="btn learned-toggle"
  data-learned-toggle
  data-skip-id={skipId}
  aria-pressed="false"
>
  <Check size={16} aria-hidden="true" />
  <span data-learned-toggle-label>Mark as learned</span>
</button>

<script>
  const STORAGE_KEY = 'denshattack:learned-skips';

  function readLearned() {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      return new Set(raw ? JSON.parse(raw) : []);
    } catch {
      return new Set();
    }
  }

  function writeLearned(set) {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
    } catch {
      // Storage can be unavailable (private browsing, quota, disabled) —
      // this just won't persist across reloads in that case.
    }
  }

  function syncButton(btn) {
    const isLearned = readLearned().has(btn.dataset.skipId);
    btn.classList.toggle('btn--learned', isLearned);
    btn.setAttribute('aria-pressed', String(isLearned));
    const label = btn.querySelector('[data-learned-toggle-label]');
    if (label) label.textContent = isLearned ? 'Learned' : 'Mark as learned';
  }

  // The server-rendered button always starts as "not learned" (no way to
  // read localStorage at build time) — this corrects it right after mount,
  // and again after every view transition.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-learned-toggle]').forEach(syncButton);
  });

  document.addEventListener('click', (e) => {
    const btn = e.target.closest?.('[data-learned-toggle]');
    if (!btn) return;

    const id = btn.dataset.skipId;
    const learned = readLearned();
    if (learned.has(id)) learned.delete(id);
    else learned.add(id);
    writeLearned(learned);
    syncButton(btn);
  });
</script>
