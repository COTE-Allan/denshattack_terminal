---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import PageLoadingBar from '../components/PageLoadingBar.astro';
import sticker from '../assets/sticker_smile.png';
import '../styles/global.scss';

const { title, description = '', image = '', jsonLd = null } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || sticker.src, Astro.site); // falls back to the mascot sticker for pages with no thumbnail
const pageTitle = title ? `Denshattack Station - ${title}` : 'Denshattack Station';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {/* open graph + twitter card: link-preview cards on discord, twitter/x, etc. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {/* structured data for search engines, passed in by detail pages with a demo video */}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />
  </head>
  <body>
    <PageLoadingBar />
    <Header />
    <slot />
    <img
      class="page-sticker"
      src={sticker.src}
      width={sticker.width}
      height={sticker.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <Footer />
    <BackToTop />
  </body>
</html>
