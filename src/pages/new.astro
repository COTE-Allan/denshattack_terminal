---
import Base from '../layouts/Base.astro';
import RecentItems from '../components/RecentItems.jsx';

const RECENT_DAYS = 30; // wider window than the catalogue cards' own "new!" badge (7 days)
---

<Base
  title="What's new"
  description={`Skips, techniques, and stickers added or updated in the last ${RECENT_DAYS} days.`}
>
  <main>
    <div class="page-header">
      <h1>What's new</h1>
    </div>

    <RecentItems
      client:load
      emptyText={`Nothing added or updated in the last ${RECENT_DAYS} days. Check back soon.`}
    />
  </main>
</Base>
