---
import Base from '../../layouts/Base.astro';
import { getTechniques } from '../../lib/wp.js';
import { youtubeId, youtubeStart } from '../../lib/format.js';

/**
 * One static page per technique.
 * getStaticPaths runs once at build time and returns every route to generate.
 */
export async function getStaticPaths() {
  const techniques = await getTechniques();

  return techniques.map((t) => ({
    params: { slug: t.slug },
    props: { technique: t },
  }));
}

const { technique: t } = Astro.props;
const videoId = youtubeId(t.youtubeLink);
const videoStart = youtubeStart(t.youtubeLink);
---

<Base title={t.title} description={t.summary}>
  <main class="technique-page">
    <p class="breadcrumb"><a href="/techniques/">Back to techniques</a></p>

    <article>
      <h1 class="detail__title">{t.title}</h1>

      {t.variantOfSlug && (
        <p class="technique-page__variant-of">
          Variant of{' '}
          <a href={`/techniques/${t.variantOfSlug}/`}>{t.variantOfTitle}</a>
        </p>
      )}

      {/*
        set:html renders the ACF description as real HTML.
        Safe because this content only ever comes from the admin.
      */}
      {t.description && (
        <div class="detail__body" set:html={t.description} />
      )}

      {videoId ? (
        <div class="detail__video">
          {/* youtube-nocookie: no tracking cookie until the visitor plays. */}
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${videoId}${videoStart ? `?start=${videoStart}` : ''}`}
            title={`Demonstration: ${t.title}`}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        t.youtubeLink && (
          <p class="technique-page__video-link">
            <a class="btn" href={t.youtubeLink} target="_blank" rel="noopener nofollow">
              Watch the demonstration
            </a>
          </p>
        )
      )}
    </article>

    {t.variants.length > 0 && (
      <section class="technique-page__variants">
        <h2>Variants</h2>

        {t.variants.map((v) => {
          const variantVideoId = youtubeId(v.youtubeLink);
          const variantVideoStart = youtubeStart(v.youtubeLink);

          return (
            <article class="technique-page__variant">
              <h3>{v.title}</h3>

              {v.description && <div class="detail__body" set:html={v.description} />}

              {variantVideoId ? (
                <div class="detail__video">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${variantVideoId}${variantVideoStart ? `?start=${variantVideoStart}` : ''}`}
                    title={`Demonstration: ${v.title}`}
                    loading="lazy"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              ) : (
                v.youtubeLink && (
                  <p class="technique-page__video-link">
                    <a class="btn" href={v.youtubeLink} target="_blank" rel="noopener nofollow">
                      Watch the demonstration
                    </a>
                  </p>
                )
              )}
            </article>
          );
        })}
      </section>
    )}
  </main>
</Base>
