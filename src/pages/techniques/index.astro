---
import Base from '../../layouts/Base.astro';
import TechniqueCatalog from '../../components/TechniqueCatalog.jsx';
import { getTechniques } from '../../lib/wp.js';

// Runs at build time. If WordPress is unreachable the build fails loudly
// rather than shipping an empty catalogue.
const allTechniques = await getTechniques();

// Variants have their own page (linked from their parent's), so they don't
// also need a slot in the main grid.
const techniques = allTechniques.filter((t) => !t.variantOfId);
---

<Base title="Techniques" description="Speedrun techniques.">
  <main>
    <div class="page-header">
      <h1>Techniques</h1>
      <a class="btn" href="/techniques/submit/">Add a technique</a>
    </div>

    {/*
      client:load hydrates on page load so filters work immediately.
      Swap for client:visible if the list sits far down the page.
    */}
    <TechniqueCatalog client:load techniques={techniques} />

    <div class="page-footer-cta">
      <a class="btn" href="/techniques/submit/">Add a technique</a>
    </div>
  </main>
</Base>
