---
import Base from '../../layouts/Base.astro';
import TechniqueCatalog from '../../components/TechniqueCatalog.jsx';
---

<Base title="Techniques" description="Speedrun techniques.">
  <main>
    <div class="page-header">
      <h1>Techniques</h1>
      <a class="btn" href="/techniques/submit/">Add a technique</a>
    </div>

    {/* client:load hydrates on page load: fetches and filters entirely in the browser */}
    <TechniqueCatalog client:load />

    <div class="page-footer-cta">
      <a class="btn" href="/techniques/submit/">Add a technique</a>
    </div>
  </main>
</Base>
