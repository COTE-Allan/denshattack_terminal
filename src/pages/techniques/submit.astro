---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import SubmitForm from '../../components/SubmitForm.jsx';
import { getTechniques, restBase } from '../../lib/wp.js';

const endpoint = `${restBase()}/denshattack/v1/submit-technique`;

// Runs at build time. Only base techniques are offered as a parent — a
// variant of a variant would be a confusing third level of nesting.
const allTechniques = await getTechniques();
const baseTechniques = allTechniques.filter((t) => !t.variantOfId);

const fields = [
  { name: 'name', label: 'Technique name', required: true, maxLength: 120 },
  {
    name: 'variantOf',
    label: 'Variant of (optional)',
    type: 'select',
    options: baseTechniques.map((t) => ({ value: String(t.databaseId), label: t.title })),
  },
  { name: 'youtubeLink', label: 'YouTube link', type: 'url', required: true },
  { name: 'description', label: 'Description', type: 'textarea', maxLength: 2000 },
];
---

<Base title="Add a technique" description="Submit a new technique for review.">
  <main>
    <BackLink href="/techniques/" label="Back to techniques" />

    <h1 class="detail__title">Add a technique</h1>
    <p class="submit-form__intro">
      Found a new technique? Send it our way. It'll show up in the catalogue
      once it's reviewed.
    </p>

    <SubmitForm client:load endpoint={endpoint} submitLabel="Add technique" fields={fields} />
  </main>
</Base>
