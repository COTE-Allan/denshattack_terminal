---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import TechniqueSubmitForm from '../../components/TechniqueSubmitForm.jsx';
import { restBase } from '../../lib/wp.js';

const endpoint = `${restBase()}/denshattack/v1/submit-technique`;
---

<Base title="Add a technique" description="Submit a new technique for review.">
  <main>
    <BackLink href="/techniques/" label="Back to techniques" />

    <h1 class="detail__title">Add a technique</h1>
    <p class="submit-form__intro">
      Found a new technique? Send it our way. It'll show up in the catalogue
      once it's reviewed.
    </p>

    <TechniqueSubmitForm client:load endpoint={endpoint} />
  </main>
</Base>
