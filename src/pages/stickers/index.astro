---
import Base from '../../layouts/Base.astro';
import StickerCatalog from '../../components/StickerCatalog.jsx';
import { getStickers, facet } from '../../lib/wp.js';

// Runs at build time. If WordPress is unreachable the build fails loudly
// rather than shipping an empty catalogue.
const stickers = await getStickers();

const facets = {
  artists: facet(stickers, 'artist'),
};
---

<Base title="Stickers" description="Sticker catalogue.">
  <main>
    <div class="page-header">
      <h1>Stickers</h1>
      <a class="btn" href="/stickers/submit/">Add a sticker</a>
    </div>

    {/*
      client:load hydrates on page load so filters work immediately.
      Swap for client:visible if the list sits far down the page.
    */}
    <StickerCatalog client:load stickers={stickers} facets={facets} />

    <div class="page-footer-cta">
      <a class="btn" href="/stickers/submit/">Add a sticker</a>
    </div>
  </main>
</Base>
