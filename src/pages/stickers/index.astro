---
import Base from '../../layouts/Base.astro';
import StickerCatalog from '../../components/StickerCatalog.jsx';
---

<Base title="Stickers" description="Sticker catalogue.">
  <main>
    <div class="page-header">
      <h1>Stickers</h1>
      <a class="btn" href="/stickers/submit/">Add a sticker</a>
    </div>

    {/* client:load hydrates on page load: fetches and filters entirely in the browser */}
    <StickerCatalog client:load />

    <div class="page-footer-cta">
      <a class="btn" href="/stickers/submit/">Add a sticker</a>
    </div>
  </main>
</Base>
