---
import Base from '../../layouts/Base.astro';
import SubmitForm from '../../components/SubmitForm.jsx';
import { restBase } from '../../lib/wp.js';

const endpoint = `${restBase()}/denshattack/v1/submit-sticker`;

const fields = [
  { name: 'name', label: 'Sticker name', required: true, maxLength: 120 },
  { name: 'artist', label: 'Artist', required: true, maxLength: 80 },
  { name: 'tags', label: 'Tags (comma-separated)', maxLength: 200 },
  { name: 'stickerImage', label: 'Sticker image', type: 'file', required: true },
  { name: 'screenshot', label: 'In-game screenshot', type: 'file' },
];
---

<Base title="Add a sticker" description="Submit a new sticker for review.">
  <main>
    <p class="breadcrumb"><a href="/stickers/">Back to stickers</a></p>

    <h1 class="detail__title">Add a sticker</h1>
    <p class="submit-form__intro">
      Made a sticker? Upload the artwork and a screenshot. It'll show up in
      the catalogue once it's reviewed.
    </p>

    <SubmitForm client:load endpoint={endpoint} submitLabel="Add sticker" fields={fields} />
  </main>
</Base>
