---
import Base from '../layouts/Base.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import SearchBox from '../components/SearchBox.astro';
import RecentItems from '../components/RecentItems.jsx';
import logo from '../assets/logo_denshattack_terminal.png';
import heroVideo from '../assets/hero_banner_video.mp4';

const MAX_HOME_ITEMS = 6;
---

<Base
  description="The community platform for Denshattack fans and speedrunners."
>
  <main class="home-page">
    <section class="hero">
      <video
        class="hero__video"
        src={heroVideo}
        autoplay
        muted
        loop
        playsinline
      ></video>
      <div class="hero__overlay"></div>

      <div class="hero__content">
        <h1 class="hero__logo">
          <img
            src={logo.src}
            width={logo.width}
            height={logo.height}
            alt="Denshattack Station"
          />
        </h1>
        <p class="hero__tagline">
          The community platform for Denshattack fans and speedrunners: skips,
          techniques, stickers, and more to come.
        </p>

        <SearchBox
          resultsId="home-search-results"
          size="large"
          placeholder="Search skips, techniques, stickers…"
        />

        <div class="hero__links">
          <a class="btn" href="/skips/">Skips</a>
          <a class="btn" href="/techniques/">Techniques</a>
          <a class="btn" href="/stickers/">Stickers</a>
          <a class="btn" href="/stats">Stats</a>
          <a class="btn btn--discord" href="https://discord.gg/ewmbqvtYQj" target="_blank" rel="noopener">
            <DiscordIcon size={16} /> Join the Discord
          </a>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="page-header">
        <h2>What's new</h2>
        <a class="home-section__see-all" href="/new">See all →</a>
      </div>

      <RecentItems client:load max={MAX_HOME_ITEMS} />
    </section>
  </main>
</Base>
