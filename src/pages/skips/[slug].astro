---
import { Clock, Star } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import CopyLinkButton from '../../components/CopyLinkButton.astro';
import LearnedToggle from '../../components/LearnedToggle.astro';
import { getSkips } from '../../lib/wp.js';
import {
  difficultyStarCount,
  formatSeconds,
  timeSaveTier,
  timeSaveWatchCount,
  youtubeId,
  youtubeStart,
} from '../../lib/format.js';

/**
 * One static page per skip.
 * getStaticPaths runs once at build time and returns every route to generate.
 */
export async function getStaticPaths() {
  const skips = await getSkips();

  return skips.map((s) => ({
    params: { slug: s.slug },
    props: { skip: s },
  }));
}

const { skip: s } = Astro.props;
const videoId = youtubeId(s.youtubeLink);
const videoStart = youtubeStart(s.youtubeLink);
const timesaveTier = timeSaveTier(s.timesave);
const difficultyCount = difficultyStarCount(s.difficulty);
const watchCount = timeSaveWatchCount(s.timesave);
const ogImage = videoId ? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg` : '';
const jsonLd = videoId
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: s.title,
      description: s.summary || s.title,
      thumbnailUrl: `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`,
      uploadDate: s.modified,
      embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
    }
  : null;
---

<Base title={s.title} description={s.summary} image={ogImage} jsonLd={jsonLd}>
  <main class="skip-page">
    <BackLink href="/skips/" label="Back to catalogue" />

    <article>
      <h1 class="detail__title">{s.title}</h1>

      <dl class="detail__meta">
        {s.level && (
          <>
            <dt>Level</dt>
            <dd data-level={s.level}>{s.level}</dd>
          </>
        )}
        {s.foundBy && (
          <>
            <dt>Found by</dt>
            <dd>{s.foundBy}</dd>
          </>
        )}
        {s.difficulty && (
          <>
            <dt>Difficulty</dt>
            <dd class="card__stars" data-difficulty={s.difficulty}>
              {difficultyCount > 0 ? (
                Array.from({ length: difficultyCount }).map(() => (
                  <Star size={14} fill="currentColor" />
                ))
              ) : (
                s.difficulty
              )}
            </dd>
          </>
        )}
        {timesaveTier && (
          <>
            <dt>Time save</dt>
            <dd class="card__timesave" title={timesaveTier.label}>
              {Array.from({ length: watchCount }).map(() => (
                <Clock size={14} />
              ))}
              {formatSeconds(s.timesave)}
            </dd>
          </>
        )}
      </dl>

      {/*
        set:html renders the ACF description as real HTML.
        Safe because this content only ever comes from the admin.
      */}
      {s.description && (
        <div class="detail__body" set:html={s.description} />
      )}

      {videoId ? (
        <div class="detail__video">
          {/* youtube-nocookie: no tracking cookie until the visitor plays. */}
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${videoId}${videoStart ? `?start=${videoStart}` : ''}`}
            title={`Demonstration: ${s.title}`}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        s.youtubeLink && (
          <p class="skip-page__video-link">
            <a class="btn" href={s.youtubeLink} target="_blank" rel="noopener nofollow">
              Watch the demonstration
            </a>
          </p>
        )
      )}

      <div class="skip-page__actions">
        <LearnedToggle skipId={s.id} />
        <CopyLinkButton />
      </div>
    </article>
  </main>
</Base>
