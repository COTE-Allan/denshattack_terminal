---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog.jsx';
---

<Base title="Skips" description="Speedrun skips.">
  <main>
    <div class="page-header">
      <h1>Skips</h1>
      <a class="btn" href="/skips/submit/">Add a skip</a>
    </div>

    {/* client:load hydrates on page load: fetches and filters entirely in the browser */}
    <Catalog client:load />

    <div class="page-footer-cta">
      <a class="btn" href="/skips/submit/">Add a skip</a>
    </div>
  </main>
</Base>
