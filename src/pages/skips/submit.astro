---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import SkipSubmitForm from '../../components/SkipSubmitForm.jsx';
import { restBase } from '../../lib/wp.js';

const endpoint = `${restBase()}/denshattack/v1/submit-skip`;
---

<Base title="Add a skip" description="Submit a new skip for review.">
  <main>
    <BackLink href="/skips/" label="Back to catalogue" />

    <h1 class="detail__title">Add a skip</h1>
    <p class="submit-form__intro">
      Found a new skip? Send it our way. It'll show up in the catalogue once
      it's reviewed.
    </p>

    <SkipSubmitForm client:load endpoint={endpoint} />
  </main>
</Base>
