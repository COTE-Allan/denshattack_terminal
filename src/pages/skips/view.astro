---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import SkipDetail from '../../components/SkipDetail.jsx';
---

{/* one shell for every skip: apache rewrites /skips/<slug>/ here, the slug is read client-side */}
<Base title="Skip details" description="Speedrun skip details.">
  <main class="skip-page">
    <BackLink href="/skips/" label="Back to catalogue" />
    <SkipDetail client:load />
  </main>
</Base>
